module

public import Mathlib

@[expose] public section

/-!
# The Euclidean algorithm is not optimal among uniform processes

This file is the statement surface: it imports only Mathlib, defines every notion the
theorems use, and states the results with `sorry`. `Solution.lean` imports the proofs in
`ShortGCD`, where every declaration below is defined and proved under the same name.

**Context.** Van den Dries and Moschovakis conjectured that Euclid's algorithm is optimal,
up to a constant factor, in the number of remainder calls needed to compute `gcd(a, b)` or to
decide coprimeness. Moschovakis's book *Abstract Recursion and Intrinsic Complexity*
(Lecture Notes in Logic 48, 2019, doi:10.1017/9781108234238) measures this by the *intrinsic
complexity*: the least number of remainder facts in a *certificate*, a finite partial
substructure of `Nε = (ℕ, rem, eq0, eq1)` generated by the inputs such that every
homomorphism on it respects the function or relation (the Homomorphism Test). Every
uniform process, in particular every deterministic or nondeterministic recursive program
from these primitives, makes at least that many remainder calls. That background, and the
book's theory of uniform processes, is not formalized here: the theorems below are about
the intrinsic complexities, defined directly from certificates.

**Results.** `G a b`, the least number of remainder calls in a straight-line derivation of
`gcd(a, b)`, is at most `(3 + ε) log₂ a / log₂ log₂ a` for large `a`, uniformly in `b ≤ a`.
The intrinsic complexities satisfy the same `(3 + ε)` bound, so they are `o(log a)`.
This refutes Conjecture 3.4 of Moschovakis's 2012 notes *Absolute lower bounds for uniform
processes* and the version (4F-5) of the Main Conjecture on p. 151 of the book. The Main
Conjecture for algorithms (recursive programs) is not addressed and remains open.

The lower-bound theorems show that the complexities are not small for trivial reasons:
certificates exist, so no complexity is `sInf ∅ = 0`; every certificate needs at least `G a b`
remainder facts; and the coprimeness complexity is at least `(1 − ε) log₂ log₂ N` on almost
all coprime pairs below `N`. Later sections state the bounded-memory register programs,
the answer to the closure-depth question, and the equality of the book's certificate
complexities with the ones above.
-/

open Filter Topology Finset

namespace ShortGCD

/-! ## Straight-line remainder derivations -/

/-- `Derives S n T`: starting from the finite store `S`, `n` remainder calls produce the store
`T`. Each call adds `x % y` for `x, y` already in the store with `y > 0`. No constants are
introduced, and repeated calls are counted. -/
inductive Derives : Finset ℕ → ℕ → Finset ℕ → Prop
  | refl (S) : Derives S 0 S
  | step {S T n x y} : Derives S n T → x ∈ T → y ∈ T → 0 < y →
      Derives S (n + 1) (insert (x % y) T)

/-- `Generates S k w`: some derivation from `S` with at most `k` remainder calls has `w` in its
final store. -/
def Generates (S : Finset ℕ) (k w : ℕ) : Prop :=
  ∃ n T, n ≤ k ∧ Derives S n T ∧ w ∈ T

/-- `G a b`: the least number of remainder calls in a derivation of `gcd(a, b)` from `{a, b}`.
The set is nonempty because Euclid's algorithm is such a derivation. -/
noncomputable def G (a b : ℕ) : ℕ :=
  sInf {k | Generates {a,b} k (Nat.gcd a b)}

/-! ## Certificates in `Nε = (ℕ, rem, eq0, eq1)` -/

/-- A remainder fact `(x, y, r)`, standing for `rem(x, y) = r`. -/
abbrev RemFact := ℕ × ℕ × ℕ

/-- The values reachable from `a, b` using the remainder facts in `F`. -/
inductive Reach (F : Finset RemFact) (a b : ℕ) : ℕ → Prop
  | left : Reach F a b a
  | right : Reach F a b b
  | step {x y r : ℕ} : (x, y, r) ∈ F → Reach F a b x → Reach F a b y → Reach F a b r

/-- Every fact in `F` is a true remainder equation with a nonzero divisor. -/
def SoundRems (F : Finset RemFact) : Prop :=
  ∀ f ∈ F, f.2.1 ≠ 0 ∧ f.2.2 = f.1 % f.2.1

/-- A finite partial substructure of `Nε`, given by its facts: remainder equations
`rem(x, y) = r`, and values `(x, t)` of the relations `eq0(x)` (`x = 0`) and `eq1(x)`
(`x = 1`). -/
structure Cert where
  rems : Finset RemFact
  eq0s : Finset (ℕ × Bool)
  eq1s : Finset (ℕ × Bool)

namespace Cert

/-- All facts of `U` hold in `Nε`. -/
def Sound (U : Cert) : Prop :=
  SoundRems U.rems ∧ (∀ p ∈ U.eq0s, (p.1 = 0 ↔ p.2 = true)) ∧
    ∀ p ∈ U.eq1s, (p.1 = 1 ↔ p.2 = true)

/-- `U` is generated by `a, b`: every point occurring in a fact is reachable from `a, b`. -/
def Generated (U : Cert) (a b : ℕ) : Prop :=
  (∀ f ∈ U.rems, Reach U.rems a b f.1 ∧ Reach U.rems a b f.2.1) ∧
    (∀ p ∈ U.eq0s, Reach U.rems a b p.1) ∧ ∀ p ∈ U.eq1s, Reach U.rems a b p.1

/-- `π` is a homomorphism on `U`: it preserves every fact of `U` (remainders are defined only
for nonzero divisors). -/
def Respects (U : Cert) (π : ℕ → ℕ) : Prop :=
  (∀ f ∈ U.rems, π f.2.1 ≠ 0 ∧ π f.2.2 = π f.1 % π f.2.1) ∧
    (∀ p ∈ U.eq0s, (π p.1 = 0 ↔ p.2 = true)) ∧ ∀ p ∈ U.eq1s, (π p.1 = 1 ↔ p.2 = true)

/-- `U` certifies the value of `gcd(a, b)`: it is sound and generated by `a, b`, the value is a
point of `U`, and every homomorphism on `U` maps it to the gcd of the images of `a, b`. -/
def CertifiesGcd (U : Cert) (a b : ℕ) : Prop :=
  U.Sound ∧ U.Generated a b ∧ Reach U.rems a b (Nat.gcd a b) ∧
    ∀ π, U.Respects π → π (Nat.gcd a b) = Nat.gcd (π a) (π b)

end Cert

/-- The coprimeness relation `x ⊥⊥ y` of the book (§1A) and the 2012 notes:
`x, y ≥ 1` and `gcd(x, y) = 1`. -/
def BookCoprime (x y : ℕ) : Prop := 0 < x ∧ 0 < y ∧ Nat.Coprime x y

/-- `U` certifies the truth value of `a ⊥⊥ b`: every homomorphism on `U` preserves it. -/
def CertifiesCoprimeness (U : Cert) (a b : ℕ) : Prop :=
  U.Sound ∧ U.Generated a b ∧
    ∀ π, U.Respects π → (BookCoprime (π a) (π b) ↔ BookCoprime a b)

/-! ## Intrinsic complexities -/

/-- `calls(rem)(Nε, ⊥⊥, a, b)`: the least number of remainder facts in a certificate for the
truth value of `a ⊥⊥ b`. -/
noncomputable def callsCoprimeness (a b : ℕ) : ℕ :=
  sInf {k | ∃ U : Cert, CertifiesCoprimeness U a b ∧ U.rems.card = k}

/-- `calls(rem)(N₀, gcd, a, b)` for `N₀ = (ℕ, rem, eq0)`: the least number of remainder facts
in a gcd certificate with no `eq1` facts. -/
noncomputable def callsGcd (a b : ℕ) : ℕ :=
  sInf {k | ∃ U : Cert, U.CertifiesGcd a b ∧ U.eq1s = ∅ ∧ U.rems.card = k}

/-- `calls(rem)(Nε, gcd, a, b)`: the least number of remainder facts in a gcd certificate. -/
noncomputable def callsRemGcd (a b : ℕ) : ℕ :=
  sInf {k | ∃ U : Cert, U.CertifiesGcd a b ∧ U.rems.card = k}

/-! ## Upper bounds -/

/-- **Main theorem.** For every `ε > 0`, for all sufficiently large `a` and every `b ≤ a`,
`G a b ≤ (3 + ε) log₂ a / log₂ log₂ a`. Euclid's algorithm needs about `1.44 log₂ a` calls in
the worst case. -/
theorem uniform_real_bound_three {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ a : ℕ in atTop, ∀ b : ℕ, b ≤ a →
      (G a b : ℝ) ≤ (3+ε) * (Real.logb 2 a / Real.logb 2 (Real.logb 2 a)) := by
  sorry

/-- The same coefficient `3 + ε` eventually bounds all three intrinsic complexities,
uniformly over positive second inputs `b ≤ a`. -/
theorem uniform_intrinsic_bound_three {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ a : ℕ in atTop, ∀ b : ℕ, 0 < b → b ≤ a →
      (callsCoprimeness a b : ℝ) ≤
        (3+ε) * (Real.logb 2 a / Real.logb 2 (Real.logb 2 a)) ∧
      (callsGcd a b : ℝ) ≤
        (3+ε) * (Real.logb 2 a / Real.logb 2 (Real.logb 2 a)) ∧
      (callsRemGcd a b : ℝ) ≤
        (3+ε) * (Real.logb 2 a / Real.logb 2 (Real.logb 2 a)) := by
  sorry

/-! ## The refuted conjectures -/

/-- **Conjecture 3.4 of the 2012 notes is false.** There is no real `r > 0` such that
`calls(rem)(Nε, ⊥⊥, a, b) ≥ r log₂ a` for infinitely many pairs `a ≥ b ≥ 1`. -/
theorem not_conjecture_3_4 :
    ¬ ∃ r : ℝ, 0 < r ∧ {p : ℕ × ℕ | 1 ≤ p.2 ∧ p.2 ≤ p.1 ∧
      r * Real.logb 2 p.1 ≤ callsCoprimeness p.1 p.2}.Infinite := by
  sorry

/-- **Conjecture 3.4, read literally**: a rational `r > 0` and infinitely many `a`, each with
some `1 ≤ b ≤ a`. -/
theorem not_conjecture_3_4_literal :
    ¬ ∃ r : ℚ, 0 < r ∧ {a : ℕ | ∃ b, 1 ≤ b ∧ b ≤ a ∧
      (r : ℝ) * Real.logb 2 a ≤ callsCoprimeness a b}.Infinite := by
  sorry

/-- **(4F-5) is false in `N₀ = (ℕ, rem, eq0)`.** There is no `K > 0` with
`2 log₂ max(x, y) ≤ K · calls(rem)(N₀, gcd, x, y)` for infinitely many pairs `(x, y)`.
The book's first inequality in (4F-5), `calls(rem)(ε, x, y) ≤ 2 log₂ max(x, y)` for the
Euclidean algorithm `ε`, is dropped; this weakens the statement being refuted. -/
theorem not_main_conjecture_4F5 :
    ¬ ∃ K : ℝ, 0 < K ∧ {p : ℕ × ℕ |
      2 * Real.logb 2 (max p.1 p.2 : ℕ) ≤ K * callsGcd p.1 p.2}.Infinite := by
  sorry

/-- **(4F-5) is false in `Nε`**, where certificates may also use `eq1` facts. -/
theorem not_main_conjecture_4F5_Neps :
    ¬ ∃ K : ℝ, 0 < K ∧ {p : ℕ × ℕ |
      2 * Real.logb 2 (max p.1 p.2 : ℕ) ≤ K * callsRemGcd p.1 p.2}.Infinite := by
  sorry

/-- **(4F-5), read literally**, in `Nε`: there are no set `D ⊆ ℕ²` and `K > 0` such that
`2 log₂ max(x, y) ≤ K · calls(rem)(Nε, gcd, x, y)` on `D` while the complexity is unbounded on
`D` (the book's condition (4F-4)). -/
theorem not_main_conjecture_4F5_literal :
    ¬ ∃ (D : Set (ℕ × ℕ)) (K : ℝ), 0 < K ∧
      (∀ p ∈ D, 2 * Real.logb 2 (max p.1 p.2 : ℕ) ≤ K * callsRemGcd p.1 p.2) ∧
      ¬ BddAbove ((fun p : ℕ × ℕ ↦ callsRemGcd p.1 p.2) '' D) := by
  sorry

/-! ## Lower bounds: the complexities are not trivially small -/

/-- **Coprimeness certificates exist.** For `a, b ≥ 1`, some certificate settles the truth
value of `a ⊥⊥ b`, so `callsCoprimeness a b` is the size of an actual certificate, not
`sInf ∅ = 0`. -/
theorem exists_certifiesCoprimeness {a b : ℕ} (ha : 0 < a) (hb : 0 < b) :
    ∃ U : Cert, CertifiesCoprimeness U a b := by
  sorry

/-- **Gcd certificates exist.** Every pair has a gcd certificate without `eq1` facts, so
`callsGcd a b` and `callsRemGcd a b` are sizes of actual certificates, not `sInf ∅ = 0`. -/
theorem exists_certifiesGcd (a b : ℕ) : ∃ U : Cert, U.CertifiesGcd a b ∧ U.eq1s = ∅ := by
  sorry

/-- Every gcd certificate in `Nε` has at least `G a b` remainder facts. -/
theorem G_le_callsRemGcd (a b : ℕ) : G a b ≤ callsRemGcd a b := by
  sorry

/-- Every gcd certificate without `eq1` facts has at least `G a b` remainder facts. -/
theorem G_le_callsGcd (a b : ℕ) : G a b ≤ callsGcd a b := by
  sorry

/-- On positive coprime inputs, the coprimeness complexity equals `G a b`. -/
theorem callsCoprimeness_eq_G {a b : ℕ} (ha : 0 < a) (hb : 0 < b) (hc : Nat.Coprime a b) :
    callsCoprimeness a b = G a b := by
  sorry

/-- **Almost all coprime pairs have coprimeness complexity at least `(1 − ε) log₂ log₂ N`.**
For `0 < ε ≤ 1`, the number of coprime pairs `2 ≤ b < a ≤ N` with
`callsCoprimeness a b ≤ (1 − ε) log₂ log₂ N`, divided by `N²`, tends to `0`. -/
theorem tendsto_card_callsCoprimeness_loglog {ε : ℝ} (hε : 0 < ε) (hε1 : ε ≤ 1) :
    Tendsto (fun N : ℕ => ((((Finset.Icc 2 N) ×ˢ (Finset.Icc 2 N)).filter (fun p : ℕ × ℕ =>
      p.2 < p.1 ∧ Nat.Coprime p.1 p.2 ∧
        (callsCoprimeness p.1 p.2 : ℝ) ≤ (1 - ε) * Real.logb 2 (Real.logb 2 N))).card : ℝ) /
        (N : ℝ) ^ 2)
      atTop (𝓝 0) := by
  sorry

/-! ## Bounded-memory register programs

Register programs in the sense of the book (§2F, with the nondeterminism of §2E) over
`(ℕ, rem, eq0)`. A program with `k` registers is a sequence of lines numbered `0, …, L`; each
line is a halting command `halt, return t` or a list of alternative commands, each an
assignment `uᵢ := t, goto l` or a branching `if t then goto l else goto l'`. Terms are the
book's prime terms: `uᵢ`, `rem(uᵢ, uⱼ)`, `tt`, `ff` and `eq0(uᵢ)`. The remainder is partial,
so an assignment of `rem(x, 0)` has no transition. A computation starts at line `0` and
converges at a halting line whose term has a value, returning that value; its cost is the
number of remainder evaluations. `ofLabels` numbers lines written with labels from a finite
type, putting the start line at `0`.

The gcd program has `w + 2` registers: `u₀, u₁` hold the inputs `a, b` and the rest are
work registers, initially `(a, b, a, …, a)`. Line `head` returns `a` if `b = 0`. At the main
line `run` the program may assign `rem(uᵢ, uⱼ)` to any work register, or pass to the
verification of a nonzero work register `uᵢ`: it sets `u₀ := rem(u₀, uᵢ)` and
`u₁ := rem(u₁, uᵢ)`, and halts with `uᵢ` if both are zero. A zero candidate and a failed
check go to `reject`, which loops. There is no stack. `Executes w a b c z` says that some
convergent computation on `(a, b)` returns `z` with exactly `c` remainder calls.

The theorems say that every convergent computation returns the gcd, that every input has
one, and that for each `ε > 0` one fixed program of this kind has a computation of cost at
most `ε log₂ a + B` on every input `1 ≤ b ≤ a`. -/

namespace Register

/-- Prime terms of sort `ind` in the registers `u₀, …, u_{k-1}`. -/
inductive Term (k : ℕ) where
  | reg (i : Fin k)
  | rem (i j : Fin k)

/-- Prime terms of sort `boole`. -/
inductive Test (k : ℕ) where
  | tt
  | ff
  | eq0 (i : Fin k)

/-- A non-halting command, jumping to lines in `ι`. -/
inductive Cmd (k : ℕ) (ι : Type) where
  | assign (i : Fin k) (t : Term k) (l : ι)
  | branch (t : Test k) (l l' : ι)

/-- A line: a halting command, or a list of alternative commands. -/
inductive Line (k : ℕ) (ι : Type) where
  | halt (t : Term k)
  | cmds (cs : List (Cmd k ι))

/-- A register program with `k` registers: lines numbered `0, …, L`. -/
structure Program (k : ℕ) where
  L : ℕ
  line : Fin (L+1) → Line k (Fin (L+1))

variable {k : ℕ} {ι κ : Type}

/-- The value of a term, undefined for a remainder with divisor `0`. -/
def Term.value : Term k → (Fin k → ℕ) → Option ℕ
  | .reg i, u => some (u i)
  | .rem i j, u => if u j = 0 then none else some (u i % u j)

/-- The number of remainder calls made in evaluating a term. -/
def Term.calls : Term k → ℕ
  | .reg _ => 0
  | .rem _ _ => 1

/-- The value of a test. -/
def Test.value : Test k → (Fin k → ℕ) → Bool
  | .tt, _ => true
  | .ff, _ => false
  | .eq0 i, u => decide (u i = 0)

/-- One transition, with its remainder cost, of the program whose lines are `P`. -/
inductive Step (P : ι → Line k ι) : ι × (Fin k → ℕ) → ℕ → ι × (Fin k → ℕ) → Prop
  | assign {l : ι} {u : Fin k → ℕ} {cs i t l' v} (hl : P l = .cmds cs)
      (hc : Cmd.assign i t l' ∈ cs) (hv : t.value u = some v) :
      Step P (l, u) t.calls (l', Function.update u i v)
  | branch {l : ι} {u : Fin k → ℕ} {cs t l' l''} (hl : P l = .cmds cs)
      (hc : Cmd.branch t l' l'' ∈ cs) :
      Step P (l, u) 0 (cond (t.value u) l' l'', u)

/-- Finite computations, with their total remainder cost. -/
inductive Trace (P : ι → Line k ι) : ι × (Fin k → ℕ) → ℕ → ι × (Fin k → ℕ) → Prop
  | refl (s) : Trace P s 0 s
  | cons {s t u c c'} (hs : Step P s c t) (ht : Trace P t c' u) : Trace P s (c+c') u

/-- From state `s`, some convergent computation returns `z` with `c` remainder calls. -/
def Halts (P : ι → Line k ι) (s : ι × (Fin k → ℕ)) (c z : ℕ) : Prop :=
  ∃ l u t c', Trace P s c' (l, u) ∧ P l = .halt t ∧ t.value u = some z ∧ c = c'+t.calls

/-- Started at line `0` with registers `x`, some convergent computation of `P` returns `z`
with `c` remainder calls. -/
def Program.Returns (P : Program k) (x : Fin k → ℕ) (c z : ℕ) : Prop :=
  Halts P.line (0, x) c z

/-! ## Numbering the lines -/

/-- Rename the lines a command jumps to. -/
def Cmd.map (e : ι → κ) : Cmd k ι → Cmd k κ
  | .assign i t l => .assign i t (e l)
  | .branch t l l' => .branch t (e l) (e l')

/-- Rename the lines of a line's commands. -/
def Line.map (e : ι → κ) : Line k ι → Line k κ
  | .halt t => .halt t
  | .cmds cs => .cmds (cs.map (Cmd.map e))

/-- A numbering of a finite type of labels with `s` at `0`. -/
noncomputable def numbering [Fintype ι] (s : ι) : ι ≃ Fin (Fintype.card ι - 1 + 1) :=
  have h : Fintype.card ι = Fintype.card ι - 1 + 1 :=
    (Nat.sub_one_add_one (Fintype.card_pos_iff.mpr ⟨s⟩).ne').symm
  let e := Fintype.equivFinOfCardEq h
  e.trans (Equiv.swap (e s) 0)

/-- The program whose lines are `P`, numbered with the start line `s` at `0`. -/
noncomputable def ofLabels [Fintype ι] (P : ι → Line k ι) (s : ι) : Program k where
  L := Fintype.card ι - 1
  line m := (P ((numbering s).symm m)).map (numbering s)

end Register

namespace TailProgram.Fixed

/-- The prefix length `h = k² + 1` for contraction ratio `k = 2^p`. -/
def prefixLength (p : ℕ) := (2^p)^2+1
/-- The number of work registers, `h + 4 = 4^p + 5`. -/
def width (p : ℕ) := prefixLength p+4

end TailProgram.Fixed

namespace TailSource
open TailProgram Register

/-- The lines of the program, by name. -/
inductive Label (w : ℕ) where
  | head
  | ret
  | run
  | reject
  | left (i : Fin w)
  | leftTest (i : Fin w)
  | right (i : Fin w)
  | rightTest (i : Fin w)
  | done (i : Fin w)
  deriving DecidableEq, Fintype

/-- The input registers `u₀, u₁` and the work register `u_{2+j}`. -/
def inA {w} : Fin (2+w) := Fin.castAdd w 0
def inB {w} : Fin (2+w) := Fin.castAdd w 1
def work {w} (j : Fin w) : Fin (2+w) := Fin.natAdd 2 j

/-- The commands of the main line: any remainder assignment between work registers, or the
verification of a nonzero candidate. -/
def mainCmds (w : ℕ) : List (Cmd (2+w) (Label w)) :=
  (List.finRange w).flatMap (fun i => (List.finRange w).flatMap fun j =>
    (List.finRange w).map fun d => .assign (work d) (.rem (work i) (work j)) .run) ++
  (List.finRange w).map fun i => .branch (.eq0 (work i)) .reject (.left i)

/-- The lines of the program. -/
def lines (w : ℕ) : Label w → Line (2+w) (Label w)
  | .head => .cmds [.branch (.eq0 inB) .ret .run]
  | .ret => .halt (.reg inA)
  | .run => .cmds (mainCmds w)
  | .reject => .cmds [.branch .tt .reject .reject]
  | .left i => .cmds [.assign inA (.rem inA (work i)) (.leftTest i)]
  | .leftTest i => .cmds [.branch (.eq0 inA) (.right i) .reject]
  | .right i => .cmds [.assign inB (.rem inB (work i)) (.rightTest i)]
  | .rightTest i => .cmds [.branch (.eq0 inB) (.done i) .reject]
  | .done i => .halt (.reg (work i))

/-- The register program, with its lines numbered from `head = 0`. -/
noncomputable def program (w : ℕ) : Program (2+w) := ofLabels (lines w) .head

/-- The initial registers `(a, b, a, b, a, …, a)`. -/
def init (w a b : ℕ) : Fin (2+w) → ℕ := fun x => if x.val = 1 ∨ x.val = 3 then b else a

/-- A convergent computation of the program on `(a, b)` returns `z` with `c` remainder
calls. -/
def Executes (w a b c z : ℕ) : Prop := (program w).Returns (init w a b) c z

/-- Every convergent computation returns the gcd, whatever the choices. -/
theorem executes_correct {w a b c z} (h : Executes w a b c z) : z = Nat.gcd a b := by
  sorry

/-- With at least two work registers, every input has a convergent computation. -/
theorem executes_total {w} (hw : 2 ≤ w) (a b : ℕ) :
    ∃ c, Executes w a b c (Nat.gcd a b) := by
  sorry

/-- **Arbitrarily small coefficients.** For every `ε > 0` there are `p > 0` and `B ≥ 0` such
that the fixed program with `4^p + 5` work registers has, on every input `1 ≤ b ≤ a`, a
convergent computation returning `gcd(a, b)` with at most `ε log₂ a + B` remainder calls. -/
theorem arbitrarily_small_coefficient {ε : ℝ} (hε : 0 < ε) :
    ∃ p : ℕ, 0 < p ∧ ∃ B : ℝ, 0 ≤ B ∧ ∀ a b : ℕ, 1 ≤ b → b ≤ a →
      ∃ c, Executes (Fixed.width p) a b c (Nat.gcd a b) ∧
        (c:ℝ) ≤ ε*Real.logb 2 a+B := by
  sorry

end TailSource

/-! ## Closure depth

Van den Dries and Moschovakis, *Arithmetic complexity* (ACM TOCL 10(1), 2009), measure the
parallel depth of the gcd (p. 2:6), with the conventions of p. 2:4: `iq(a, b) = ⌊a / b⌋`,
`rem(a, b) = a - b·iq(a, b)`, `iq(a, 0) = a` and `rem(a, 0) = a`. Starting from
`S₀ = {0, 1, a, b}`, each stage adjoins `x + y`, `x - y`, `iq(x, y)` and `rem(x, y)` for all
`x, y` in the previous stage, and `g(a, b)` is the least stage containing `gcd(a, b)`. They
ask (Open Problem, p. 2:11) whether there are positive integers `αₙ → ∞` and `βₙ` and a
`C > 0` with `g(αₙ, βₙ) > C log αₙ` for all `n`. The theorem below says there are none. -/

namespace ClosureDepth

/-- Integer quotient `⌊a / b⌋`, with `iq(a, 0) = a`. -/
def iq (a b : ℤ) : ℤ := if b = 0 then a else ⌊(a : ℚ) / b⌋

/-- Remainder `a - b·iq(a, b)`; in particular `rem(a, 0) = a`. -/
def rem (a b : ℤ) : ℤ := a - b * iq a b

/-- The closure stages `S_k(a, b)`. -/
def stage (a b : ℤ) : ℕ → Set ℤ
  | 0 => {0, 1, a, b}
  | k+1 => stage a b k ∪ {z | ∃ x ∈ stage a b k, ∃ y ∈ stage a b k,
      z = x + y ∨ z = x - y ∨ z = iq x y ∨ z = rem x y}

/-- The closure depth `g(a, b)`: the least stage containing `gcd(a, b)`. -/
noncomputable def depth (a b : ℤ) : ℕ := sInf {k | (Int.gcd a b : ℤ) ∈ stage a b k}

/-- **Answer to the Open Problem.** There are no positive integers `αₙ → ∞`, `βₙ` and
`C > 0` with `g(αₙ, βₙ) > C log₂ αₙ` for all `n`. -/
theorem no_logarithmic_sequences :
    ¬ ∃ (α β : ℕ → ℕ) (C : ℝ), 0 < C ∧ Tendsto α atTop atTop ∧
      (∀ n, 0 < α n ∧ 0 < β n) ∧ ∀ n, C * Real.logb 2 (α n) < depth (α n) (β n) := by
  sorry

end ClosureDepth

/-! ## The book's certificates

The definitions of Moschovakis's book for `Nε` and `N₀` (§§1D, 4C–4E), stated directly: a finite
partial substructure of `Nε` given by its universe and partial operations, generation by the
inputs, homomorphisms defined on the universe, certification, the norm `calls(rem)` (the number
of entries in the graph of `rem`) and the resulting intrinsic complexities. The theorems say these
are exactly the fact-based complexities used in the refutations above. -/

namespace Book

/-- A finite partial structure in the vocabulary `{rem, eq0, eq1}`: a finite universe and partial
operations, given as functions with values in `Option`. -/
structure Struct where
  univ : Finset ℕ
  rem : ℕ → ℕ → Option ℕ
  eq0 : ℕ → Option Bool
  eq1 : ℕ → Option Bool

namespace Struct

/-- `U ⊆ₚ Nε`: the operations act on the universe and agree with those of `Nε` where defined. -/
def IsSub (U : Struct) : Prop :=
  (∀ x y w, U.rem x y = some w → x ∈ U.univ ∧ y ∈ U.univ ∧ w ∈ U.univ ∧ y ≠ 0 ∧ w = x % y) ∧
  (∀ x t, U.eq0 x = some t → x ∈ U.univ ∧ (x = 0 ↔ t = true)) ∧
  (∀ x t, U.eq1 x = some t → x ∈ U.univ ∧ (x = 1 ↔ t = true))

/-- The elements reached from `a, b` by the operations of `U`. -/
inductive Gen (U : Struct) (a b : ℕ) : ℕ → Prop
  | left : Gen U a b a
  | right : Gen U a b b
  | rem {x y w : ℕ} : U.rem x y = some w → Gen U a b x → Gen U a b y → Gen U a b w

/-- `U` is generated by `a, b` (and contains them). -/
def Generated (U : Struct) (a b : ℕ) : Prop :=
  a ∈ U.univ ∧ b ∈ U.univ ∧ ∀ x ∈ U.univ, U.Gen a b x

/-- A homomorphism `π : U → Nε`, defined on the universe of `U`. -/
def IsHom (U : Struct) (π : U.univ → ℕ) : Prop :=
  (∀ x y w : U.univ, U.rem x y = some w → π y ≠ 0 ∧ π w = π x % π y) ∧
  (∀ (x : U.univ) (t : Bool), U.eq0 x = some t → (π x = 0 ↔ t = true)) ∧
  (∀ (x : U.univ) (t : Bool), U.eq1 x = some t → (π x = 1 ↔ t = true))

/-- `calls(rem)(U)`: the number of entries in the graph of `rem` in `U`. -/
def calls (U : Struct) : ℕ :=
  ((U.univ ×ˢ U.univ).filter (fun p => (U.rem p.1 p.2).isSome)).card

/-- `U` certifies `gcd(a, b)` in `Nε`. -/
def CertifiesGcd (U : Struct) (a b : ℕ) : Prop :=
  U.IsSub ∧ U.Generated a b ∧ Nat.gcd a b ∈ U.univ ∧
    ∀ π, U.IsHom π → ∀ (ha : a ∈ U.univ) (hb : b ∈ U.univ) (hg : Nat.gcd a b ∈ U.univ),
      π ⟨_, hg⟩ = Nat.gcd (π ⟨a, ha⟩) (π ⟨b, hb⟩)

/-- `U` certifies the truth value of `a ⊥⊥ b` in `Nε`. -/
def CertifiesCoprimeness (U : Struct) (a b : ℕ) : Prop :=
  U.IsSub ∧ U.Generated a b ∧
    ∀ π, U.IsHom π → ∀ (ha : a ∈ U.univ) (hb : b ∈ U.univ),
      (BookCoprime (π ⟨a, ha⟩) (π ⟨b, hb⟩) ↔ BookCoprime a b)

end Struct

/-- The book's `calls(rem)(Nε, ⊥⊥, a, b)`. -/
noncomputable def callsCoprimeness (a b : ℕ) : ℕ :=
  sInf {k | ∃ U : Struct, U.CertifiesCoprimeness a b ∧ U.calls = k}

/-- The book's `calls(rem)(Nε, gcd, a, b)`. -/
noncomputable def callsRemGcd (a b : ℕ) : ℕ :=
  sInf {k | ∃ U : Struct, U.CertifiesGcd a b ∧ U.calls = k}

/-- The book's `calls(rem)(N₀, gcd, a, b)`: certificates in `N₀` have no `eq1` entries. -/
noncomputable def callsGcd (a b : ℕ) : ℕ :=
  sInf {k | ∃ U : Struct, U.CertifiesGcd a b ∧ (∀ x, U.eq1 x = none) ∧ U.calls = k}

/-- The book's `calls(rem)(Nε, ⊥⊥, a, b)` is `callsCoprimeness a b`. -/
theorem callsCoprimeness_eq (a b : ℕ) :
    callsCoprimeness a b = ShortGCD.callsCoprimeness a b := by
  sorry

/-- The book's `calls(rem)(Nε, gcd, a, b)` is `callsRemGcd a b`. -/
theorem callsRemGcd_eq (a b : ℕ) : callsRemGcd a b = ShortGCD.callsRemGcd a b := by
  sorry

/-- The book's `calls(rem)(N₀, gcd, a, b)` is `callsGcd a b`. -/
theorem callsGcd_eq (a b : ℕ) : callsGcd a b = ShortGCD.callsGcd a b := by
  sorry

end Book

end ShortGCD
