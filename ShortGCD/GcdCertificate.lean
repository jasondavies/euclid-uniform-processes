module

public import ShortGCD.RemainderList

@[expose] public section

/-!
# The gcd version

The Main Conjecture is about algorithms that *compute* `gcd(x, y)`. A certificate for the gcd
at `(a, b)` must contain the value `gcd(a, b)` as a point, and every homomorphism must map it to
the gcd of the images. For coprime `a, b` the value `1` must then be reachable, so the
intrinsic `calls(rem)`-complexity of the gcd is at least `D a b`; conversely the facts
`rem(a, 1) = 0`, `rem(b, 1) = 0` and `eq0(0)` turn a derivation of `1` into a certificate for
the gcd.

* `reach_gcd`: Euclid's algorithm reaches `gcd(a, b)` with facts on numbers `≤ max a b`.
* `D_le_callsRemGcd`, `callsRemGcd_le_D_add_two`: `D ≤ callsRemGcd ≤ D + 2` for coprime inputs.
-/

namespace ShortGCD

open Finset

/-- All true remainder facts with operands at most `N`. -/
def allFacts (N : ℕ) : Finset RemFact :=
  ((range (N + 1) ×ˢ range (N + 1)).filter fun p ↦ p.2 ≠ 0).image fun p ↦ (p.1, p.2, p.1 % p.2)

theorem soundRems_allFacts (N : ℕ) : SoundRems (allFacts N) := fun f hf ↦ by
  obtain ⟨p, hp, rfl⟩ := mem_image.1 hf
  exact ⟨(mem_filter.1 hp).2, rfl⟩

theorem mem_allFacts {N x y : ℕ} (hx : x ≤ N) (hy : y ≤ N) (hy0 : y ≠ 0) :
    (x, y, x % y) ∈ allFacts N :=
  mem_image.2 ⟨(x, y), mem_filter.2 ⟨by simp [Nat.lt_succ_iff.2 hx, Nat.lt_succ_iff.2 hy], hy0⟩, rfl⟩

/-- Euclid's algorithm: the gcd of two reachable numbers `≤ N` is reachable with `allFacts N`. -/
theorem reach_gcd_of_reach {N a b : ℕ} :
    ∀ x y, x ≤ N → y ≤ N → Reach (allFacts N) a b x → Reach (allFacts N) a b y →
      Reach (allFacts N) a b (Nat.gcd x y) := by
  intro x y
  induction x, y using Nat.gcd.induction with
  | H0 y => intro _ _ _ hy; simpa using hy
  | H1 x y hx0 ih =>
    intro hxN hyN hx hy
    rw [Nat.gcd_rec]
    exact ih ((Nat.mod_le _ _).trans hyN) hxN
      (.step (mem_allFacts hyN hxN hx0.ne') hy hx) hx

theorem reach_gcd (a b : ℕ) : Reach (allFacts (max a b)) a b (Nat.gcd a b) :=
  reach_gcd_of_reach a b (le_max_left a b) (le_max_right a b) .left .right

/-- For coprime inputs some derivation of `1` exists. -/
theorem derivLen_set_nonempty {a b : ℕ} (h : Nat.Coprime a b) :
    {k | ∃ F : Finset RemFact, SoundRems F ∧ Reach F a b 1 ∧ F.card = k}.Nonempty :=
  ⟨_, allFacts (max a b), soundRems_allFacts _,
    (by simpa [Nat.Coprime.gcd_eq_one h] using reach_gcd a b), rfl⟩

namespace Cert

/-- `U` certifies the value of `gcd(a, b)`: it is sound and generated by `a, b`, the value is a
point of `U`, and every homomorphism on `U` maps it to the gcd of the images of `a, b`. -/
def CertifiesGcd (U : Cert) (a b : ℕ) : Prop :=
  U.Sound ∧ U.Generated a b ∧ Reach U.rems a b (Nat.gcd a b) ∧
    ∀ π, U.Respects π → π (Nat.gcd a b) = Nat.gcd (π a) (π b)

end Cert

/-- A derivation of `1` with `k` facts gives a certificate for `gcd(a, b) = 1` with at most
`k + 2` remainder facts: add `rem(a, 1) = 0`, `rem(b, 1) = 0` and `eq0(0)`. -/
theorem exists_certGcd_of_reach_one {F : Finset RemFact} {a b : ℕ} (hab : Nat.Coprime a b)
    (hF : SoundRems F) (h1 : Reach F a b 1) :
    ∃ U : Cert, U.CertifiesGcd a b ∧ U.rems.card ≤ F.card + 2 := by
  classical
  set G := F.filter fun f ↦ Reach F a b f.1 ∧ Reach F a b f.2.1
  set R := insert (a, 1, 0) (insert (b, 1, 0) G)
  have hGR : G ⊆ R := (subset_insert _ _).trans (subset_insert _ _)
  have h1R : Reach R a b 1 := h1.filter.mono hGR
  have haR : (a, 1, 0) ∈ R := mem_insert_self _ _
  have hbR : (b, 1, 0) ∈ R := mem_insert_of_mem (mem_insert_self _ _)
  have hgcd : Nat.gcd a b = 1 := Nat.Coprime.gcd_eq_one hab
  refine ⟨⟨R, {(0, true)}, ∅⟩, ⟨⟨fun f hf ↦ ?_, by simp, by simp⟩,
    ⟨fun f hf ↦ ?_, ?_, by simp⟩, by simpa [hgcd] using h1R, fun π hπ ↦ ?_⟩, ?_⟩
  · rcases mem_insert.1 hf with rfl | hf
    · exact ⟨one_ne_zero, (Nat.mod_one a).symm⟩
    rcases mem_insert.1 hf with rfl | hf
    · exact ⟨one_ne_zero, (Nat.mod_one b).symm⟩
    exact hF f (mem_filter.1 hf).1
  · rcases mem_insert.1 hf with rfl | hf
    · exact ⟨.left, h1R⟩
    rcases mem_insert.1 hf with rfl | hf
    · exact ⟨.right, h1R⟩
    obtain ⟨-, hx, hy⟩ := mem_filter.1 hf
    exact ⟨hx.filter.mono hGR, hy.filter.mono hGR⟩
  · intro p hp
    rw [mem_singleton.1 hp]
    exact .step haR .left h1R
  · obtain ⟨hrem, h0, -⟩ := hπ
    have hπ0 : π 0 = 0 := by simpa using h0 (0, true) (by simp)
    have hdiv : ∀ x, (x, 1, 0) ∈ R → π 1 ∣ π x := fun x hx ↦ by
      obtain ⟨-, h⟩ := hrem _ hx
      exact Nat.dvd_of_mod_eq_zero (by simpa [hπ0] using h.symm)
    have hd := Reach.dvd hrem (Nat.gcd_dvd_left (π a) (π b)) (Nat.gcd_dvd_right (π a) (π b)) h1R
    rw [hgcd]
    exact Nat.dvd_antisymm (Nat.dvd_gcd (hdiv a haR) (hdiv b hbR)) hd
  · calc R.card ≤ (insert (b, 1, 0) G).card + 1 := card_insert_le _ _
      _ ≤ G.card + 1 + 1 := by have := card_insert_le (b, 1, 0) G; omega
      _ ≤ F.card + 2 := by
        have : G.card ≤ F.card := card_filter_le _ _
        omega

/-- The intrinsic `calls(rem)`-complexity of the gcd in `Nε` at `(a, b)`. -/
noncomputable def callsRemGcd (a b : ℕ) : ℕ :=
  sInf {k | ∃ U : Cert, U.CertifiesGcd a b ∧ U.rems.card = k}

theorem callsRemGcd_set_nonempty {a b : ℕ} (hab : Nat.Coprime a b) :
    {k | ∃ U : Cert, U.CertifiesGcd a b ∧ U.rems.card = k}.Nonempty := by
  obtain ⟨_, F, hF, h1, -⟩ := derivLen_set_nonempty hab
  obtain ⟨U, hU, -⟩ := exists_certGcd_of_reach_one hab hF h1
  exact ⟨_, U, hU, rfl⟩

/-- A certificate for the gcd of a coprime pair reaches `1`, so it has at least `D a b`
remainder facts. -/
theorem D_le_callsRemGcd {a b : ℕ} (hab : Nat.Coprime a b) : D a b ≤ callsRemGcd a b := by
  obtain ⟨U, hU, hk⟩ := Nat.sInf_mem (callsRemGcd_set_nonempty hab)
  rw [D_eq_derivLen, callsRemGcd, ← hk]
  exact Nat.sInf_le ⟨U.rems, hU.1.1, by simpa [Nat.Coprime.gcd_eq_one hab] using hU.2.2.1, rfl⟩

theorem callsRemGcd_le_D_add_two {a b : ℕ} (hab : Nat.Coprime a b) :
    callsRemGcd a b ≤ D a b + 2 := by
  obtain ⟨F, hF, h1, hk⟩ := Nat.sInf_mem (derivLen_set_nonempty hab)
  obtain ⟨U, hU, hcard⟩ := exists_certGcd_of_reach_one hab hF h1
  rw [D_eq_derivLen, derivLen, ← hk]
  have hmem : U.rems.card ∈ {k | ∃ U : Cert, U.CertifiesGcd a b ∧ U.rems.card = k} :=
    ⟨U, hU, rfl⟩
  exact (Nat.sInf_le hmem).trans hcard

end ShortGCD
