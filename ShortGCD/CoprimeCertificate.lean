import Mathlib

/-!
# Certificates of coprimality in the Euclidean structure

Moschovakis (*Abstract Recursion and Intrinsic Complexity*, §§4D–4E) measures the intrinsic
complexity of a relation by the least size of a *certificate*: a finite partial substructure
`U`, generated by the input, such that every homomorphism `π : U → A` respects the relation.
For coprimeness in `Nε = (ℕ, rem, eq0, eq1)` with the norm `calls(rem)` (the number of
remainder facts in `U`), we show that this least size is the length of a shortest
*remainder derivation* of `1` from `a, b`.

* `Cert`: a finite partial substructure of `Nε`, as finite sets of remainder, `eq0` and `eq1`
  facts.
* `Cert.CertifiesCoprime U a b`: `U` is sound, generated by `a, b`, and every homomorphism
  respecting its facts maps `a, b` to a coprime pair.
* `exists_cert_iff`: a certificate with at most `k` remainder facts exists iff some sound set
  of at most `k` remainder facts reaches `1` from `a, b`. The forward direction uses the
  doubling homomorphism `u ↦ 2u`, as in the book's Problem x4D.4.
* `callsRem_eq_derivLen`: the least number of remainder facts in a certificate equals
  `derivLen a b`.

Here coprimeness is `Nat.Coprime`, which allows zero inputs. For positive coprime inputs this
gives the same complexity as the book's relation `x, y ≥ 1 ∧ gcd(x, y) = 1`
(`callsCoprimeness_eq_callsRem` in `ShortGCD.Conjecture`). For non-coprime inputs `callsRem`
is `0` only because its defining set is empty; it is not the complexity of certifying
non-coprimeness, which `callsCoprimeness` measures.
-/

namespace ShortGCD

open Finset

/-- A remainder fact `(x, y, r)`, standing for `rem(x, y) = r`. -/
abbrev RemFact := ℕ × ℕ × ℕ

/-- The values reachable from `a, b` using the remainder facts in `F`. -/
inductive Reach (F : Finset RemFact) (a b : ℕ) : ℕ → Prop
  | left : Reach F a b a
  | right : Reach F a b b
  | step {x y r : ℕ} : (x, y, r) ∈ F → Reach F a b x → Reach F a b y → Reach F a b r

/-- Every fact in `F` is a true remainder equation with a nonzero divisor. -/
def SoundRems (F : Finset RemFact) : Prop :=
  ∀ f ∈ F, f.2.1 ≠ 0 ∧ f.2.2 = f.1 % f.2.1

theorem Reach.mono {F G : Finset RemFact} {a b x : ℕ} (hFG : F ⊆ G) (h : Reach F a b x) :
    Reach G a b x := by
  induction h with
  | left => exact .left
  | right => exact .right
  | step hf _ _ ihx ihy => exact .step (hFG hf) ihx ihy

/-- A common divisor of `π a` and `π b` divides `π x` for every reachable `x`, when `π`
respects the remainder facts. -/
theorem Reach.dvd {F : Finset RemFact} {a b x d : ℕ} {π : ℕ → ℕ}
    (hπ : ∀ f ∈ F, π f.2.1 ≠ 0 ∧ π f.2.2 = π f.1 % π f.2.1) (ha : d ∣ π a) (hb : d ∣ π b)
    (h : Reach F a b x) : d ∣ π x := by
  induction h with
  | left => exact ha
  | right => exact hb
  | step hf _ _ ihx ihy =>
    rw [(hπ _ hf).2]
    exact (Nat.dvd_mod_iff ihy).2 ihx

/-- Keeping only the facts whose operands are reachable does not change reachability. -/
theorem Reach.filter {F : Finset RemFact} {a b x : ℕ} [DecidablePred
    fun f : RemFact ↦ Reach F a b f.1 ∧ Reach F a b f.2.1] (h : Reach F a b x) :
    Reach (F.filter fun f ↦ Reach F a b f.1 ∧ Reach F a b f.2.1) a b x := by
  induction h with
  | left => exact .left
  | right => exact .right
  | step hf hx hy ihx ihy => exact .step (mem_filter.2 ⟨hf, hx, hy⟩) ihx ihy

/-- A finite partial substructure of `Nε = (ℕ, rem, eq0, eq1)`, given by its facts: remainder
equations `rem(x, y) = r`, and values of the relations `eq0`, `eq1`. -/
structure Cert where
  rems : Finset RemFact
  eq0s : Finset (ℕ × Bool)
  eq1s : Finset (ℕ × Bool)

namespace Cert

/-- All facts of `U` hold in `Nε`. -/
def Sound (U : Cert) : Prop :=
  SoundRems U.rems ∧ (∀ p ∈ U.eq0s, (p.1 = 0 ↔ p.2 = true)) ∧
    ∀ p ∈ U.eq1s, (p.1 = 1 ↔ p.2 = true)

/-- `U` is generated by `a, b`: every point occurring in a fact is reachable from `a, b`. -/
def Generated (U : Cert) (a b : ℕ) : Prop :=
  (∀ f ∈ U.rems, Reach U.rems a b f.1 ∧ Reach U.rems a b f.2.1) ∧
    (∀ p ∈ U.eq0s, Reach U.rems a b p.1) ∧ ∀ p ∈ U.eq1s, Reach U.rems a b p.1

/-- `π` is a homomorphism on `U`: it preserves every fact of `U` (remainders are defined only
for nonzero divisors). -/
def Respects (U : Cert) (π : ℕ → ℕ) : Prop :=
  (∀ f ∈ U.rems, π f.2.1 ≠ 0 ∧ π f.2.2 = π f.1 % π f.2.1) ∧
    (∀ p ∈ U.eq0s, (π p.1 = 0 ↔ p.2 = true)) ∧ ∀ p ∈ U.eq1s, (π p.1 = 1 ↔ p.2 = true)

/-- `U` certifies that `a` and `b` are coprime: it is sound, generated by `a, b`, and every
homomorphism on `U` respects coprimeness at `(a, b)`. -/
def CertifiesCoprime (U : Cert) (a b : ℕ) : Prop :=
  U.Sound ∧ U.Generated a b ∧ ∀ π, U.Respects π → Nat.Coprime (π a) (π b)

/-- A certificate of coprimality reaches `1` with its remainder facts. Either it contains a
fact `eq1(u) = tt` (then `u = 1` is a reachable point), or the doubling map `u ↦ 2u` is a
homomorphism on it, which sends `a, b` to a pair with common factor `2`. -/
theorem reach_one {U : Cert} {a b : ℕ} (h : U.CertifiesCoprime a b) :
    Reach U.rems a b 1 := by
  obtain ⟨⟨hrem, h0, h1⟩, ⟨-, -, hg1⟩, hcop⟩ := h
  by_cases hone : ∃ p ∈ U.eq1s, p.2 = true
  · obtain ⟨p, hp, ht⟩ := hone
    have hp1 : p.1 = 1 := (h1 p hp).2 ht
    exact hp1 ▸ hg1 p hp
  · exfalso
    have hdouble : U.Respects (2 * ·) := by
      refine ⟨fun f hf ↦ ?_, fun p hp ↦ ?_, fun p hp ↦ ?_⟩
      · obtain ⟨hy, hr⟩ := hrem f hf
        exact ⟨by positivity, by rw [hr, Nat.mul_mod_mul_left]⟩
      · dsimp only
        rw [← h0 p hp]
        omega
      · have hf : p.2 ≠ true := fun ht ↦ hone ⟨p, hp, ht⟩
        dsimp only
        exact ⟨fun h ↦ by omega, fun ht ↦ absurd ht hf⟩
    have hc := hcop _ hdouble
    have h2 : 2 ∣ Nat.gcd (2 * a) (2 * b) :=
      Nat.dvd_gcd (dvd_mul_right 2 a) (dvd_mul_right 2 b)
    rw [Nat.Coprime.gcd_eq_one hc] at h2
    omega

end Cert

/-- A certificate with at most `k` remainder facts exists iff some sound set of at most `k`
remainder facts reaches `1` from `a, b`. -/
theorem exists_cert_iff (a b k : ℕ) :
    (∃ U : Cert, U.CertifiesCoprime a b ∧ U.rems.card ≤ k) ↔
      ∃ F : Finset RemFact, SoundRems F ∧ Reach F a b 1 ∧ F.card ≤ k := by
  classical
  constructor
  · rintro ⟨U, hU, hk⟩
    exact ⟨U.rems, hU.1.1, Cert.reach_one hU, hk⟩
  · rintro ⟨F, hF, h1, hk⟩
    set G := F.filter fun f ↦ Reach F a b f.1 ∧ Reach F a b f.2.1
    refine ⟨⟨G, ∅, {(1, true)}⟩, ⟨⟨fun f hf ↦ hF f (mem_filter.1 hf).1, by simp, by simp⟩,
      ⟨fun f hf ↦ ?_, by simp, ?_⟩, fun π hπ ↦ ?_⟩, (card_filter_le _ _).trans hk⟩
    · obtain ⟨-, hx, hy⟩ := mem_filter.1 hf
      exact ⟨hx.filter, hy.filter⟩
    · simpa using h1.filter
    · have hπ1 : π 1 = 1 := by simpa using hπ.2.2 (1, true) (by simp)
      have hd := Reach.dvd hπ.1 (Nat.gcd_dvd_left (π a) (π b))
        (Nat.gcd_dvd_right (π a) (π b)) h1.filter
      rw [hπ1] at hd
      exact Nat.dvd_one.1 hd

/-- Two sets of naturals with the same upward closure have the same infimum. -/
theorem sInf_eq_of_exists_le_iff {S T : Set ℕ}
    (h : ∀ k, (∃ j ∈ S, j ≤ k) ↔ ∃ j ∈ T, j ≤ k) : sInf S = sInf T := by
  rcases S.eq_empty_or_nonempty with hS | hS
  · have hT : T = ∅ := by
      ext k
      simp only [Set.mem_empty_iff_false, iff_false]
      intro hk
      obtain ⟨j, hj, -⟩ := (h k).2 ⟨k, hk, le_rfl⟩
      simp [hS] at hj
    rw [hS, hT]
  · have hT : T.Nonempty := by
      obtain ⟨j, hj, -⟩ := (h _).1 ⟨_, hS.some_mem, le_rfl⟩
      exact ⟨j, hj⟩
    apply le_antisymm
    · obtain ⟨j, hj, hjk⟩ := (h _).2 ⟨_, Nat.sInf_mem hT, le_rfl⟩
      exact (Nat.sInf_le hj).trans hjk
    · obtain ⟨j, hj, hjk⟩ := (h _).1 ⟨_, Nat.sInf_mem hS, le_rfl⟩
      exact (Nat.sInf_le hj).trans hjk

/-- The intrinsic `calls(rem)`-complexity of `Nat.Coprime` in `Nε` at `(a, b)`: the least number
of remainder facts in a certificate. -/
noncomputable def callsRem (a b : ℕ) : ℕ :=
  sInf {k | ∃ U : Cert, U.CertifiesCoprime a b ∧ U.rems.card = k}

/-- The least number of remainder facts that reach `1` from `a, b`. -/
noncomputable def derivLen (a b : ℕ) : ℕ :=
  sInf {k | ∃ F : Finset RemFact, SoundRems F ∧ Reach F a b 1 ∧ F.card = k}

/-- **The reformulation.** The least number of remainder facts in a certificate of coprimeness
is the least number of remainder facts reaching `1`. For non-coprime pairs both sets are empty
and both sides are `0` by the `sInf ∅ = 0` convention. -/
theorem callsRem_eq_derivLen (a b : ℕ) : callsRem a b = derivLen a b := by
  apply sInf_eq_of_exists_le_iff
  intro k
  simp only [Set.mem_ofPred_eq]
  constructor
  · rintro ⟨j, ⟨U, hU, rfl⟩, hj⟩
    obtain ⟨F, hF, h1, hk⟩ := (exists_cert_iff a b k).1 ⟨U, hU, hj⟩
    exact ⟨F.card, ⟨F, hF, h1, rfl⟩, hk⟩
  · rintro ⟨j, ⟨F, hF, h1, rfl⟩, hj⟩
    obtain ⟨U, hU, hk⟩ := (exists_cert_iff a b k).2 ⟨F, hF, h1, hj⟩
    exact ⟨U.rems.card, ⟨U, hU, rfl⟩, hk⟩

end ShortGCD
