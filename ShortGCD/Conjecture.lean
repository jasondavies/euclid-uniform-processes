module

public import ShortGCD.Certificates

@[expose] public section

/-!
# The uniform-process conjectures fail

Moschovakis's 2012 notes (*Absolute lower bounds for uniform processes*, Conjecture 3.4) ask
for `r > 0` with `calls(rem)(Nε, ⊥⊥, a, b) ≥ r log a` for infinitely many `a ≥ b ≥ 1`. The
"precise version" (4F-5) of the Main Conjecture in *Abstract Recursion and Intrinsic
Complexity* (p. 151) asks for `K > 0` with `2 log max(x, y) ≤ K calls(rem)(gcd, x, y)` on an
infinite set of pairs.

Both intrinsic complexities are defined here directly from certificates: finite partial
substructures generated by the input, every homomorphism of which (every map preserving
their facts) respects the relation or function. The coprimeness relation is the book's
(§1A): `x ⊥⊥ y` iff `x, y ≥ 1` and `gcd(x, y) = 1`. Both complexities are `o(log)`
uniformly, so both conjectures fail. The deterministic Main Conjecture is not addressed.
-/

namespace ShortGCD

open Filter Finset

/-- The coprimeness relation `x ⊥⊥ y` of the book (§1A) and the 2012 notes:
`x, y ≥ 1` and `gcd(x, y) = 1`. -/
def BookCoprime (x y : ℕ) : Prop := 0 < x ∧ 0 < y ∧ Nat.Coprime x y

/-- `U` certifies the truth value of `a ⊥⊥ b` in `Nε = (ℕ, rem, eq0, eq1)`. -/
def CertifiesCoprimeness (U : Cert) (a b : ℕ) : Prop :=
  U.Sound ∧ U.Generated a b ∧
    ∀ π, U.Respects π → (BookCoprime (π a) (π b) ↔ BookCoprime a b)

/-- The intrinsic `calls(rem)`-complexity of the coprimeness relation in `Nε`, at `(a, b)`. -/
noncomputable def callsCoprimeness (a b : ℕ) : ℕ :=
  sInf {k | ∃ U : Cert, CertifiesCoprimeness U a b ∧ U.rems.card = k}

/-- The intrinsic `calls(rem)`-complexity of `gcd` in `(ℕ, rem, eq0)` (certificates without
`eq1` facts), at `(a, b)`. Allowing `eq1` facts gives `callsRemGcd`, which is no larger
(`callsRemGcd_le_callsGcd`). -/
noncomputable def callsGcd (a b : ℕ) : ℕ :=
  sInf {k | ∃ U : Cert, U.CertifiesGcd a b ∧ U.eq1s = ∅ ∧ U.rems.card = k}

/-- A certificate for `Nat.Coprime a b` becomes one for the book's `a ⊥⊥ b` after adding the
facts `eq0(a) = ff` and `eq0(b) = ff`; its remainder facts are unchanged. -/
theorem certifiesCoprimeness_of_certifiesCoprime {U : Cert} {a b : ℕ} (ha : 0 < a)
    (hb : 0 < b) (hU : U.CertifiesCoprime a b) :
    CertifiesCoprimeness { U with eq0s := insert (a, false) (insert (b, false) U.eq0s) } a b := by
  obtain ⟨⟨hrem, h0, h1⟩, ⟨gr, g0, g1⟩, hπ⟩ := hU
  have hcop : Nat.Coprime a b := hπ id ⟨fun f hf ↦ hrem f hf, h0, h1⟩
  refine ⟨⟨hrem, fun p hp ↦ ?_, h1⟩, ⟨gr, fun p hp ↦ ?_, g1⟩, fun π hπV ↦ ?_⟩
  · rcases mem_insert.1 hp with rfl | hp
    · simp; omega
    rcases mem_insert.1 hp with rfl | hp
    · simp; omega
    exact h0 p hp
  · rcases mem_insert.1 hp with rfl | hp
    · exact .left
    rcases mem_insert.1 hp with rfl | hp
    · exact .right
    exact g0 p hp
  · obtain ⟨hπr, hπ0, hπ1⟩ := hπV
    have hπa : π a ≠ 0 := by simpa using hπ0 (a, false) (by simp)
    have hπb : π b ≠ 0 := by simpa using hπ0 (b, false) (by simp)
    have hπU : U.Respects π := ⟨hπr, fun p hp ↦ hπ0 p (by simp [hp]), hπ1⟩
    exact iff_of_true ⟨Nat.pos_of_ne_zero hπa, Nat.pos_of_ne_zero hπb, hπ π hπU⟩
      ⟨ha, hb, hcop⟩

/-- For positive coprime inputs the book's complexity agrees with the `callsRem` of the
reduction, hence with `D a b` (`callsRem_eq_D`). -/
theorem callsCoprimeness_eq_callsRem {a b : ℕ} (ha : 0 < a) (hb : 0 < b)
    (hc : Nat.Coprime a b) : callsCoprimeness a b = callsRem a b := by
  have hne : {k | ∃ U : Cert, U.CertifiesCoprime a b ∧ U.rems.card = k}.Nonempty := by
    obtain ⟨U, hU, -⟩ := coprime_certificate_bound hc
    exact ⟨_, U, hU, rfl⟩
  apply le_antisymm
  · obtain ⟨U, hU, hk⟩ := Nat.sInf_mem hne
    unfold callsCoprimeness callsRem
    rw [← hk]
    exact Nat.sInf_le ⟨_, certifiesCoprimeness_of_certifiesCoprime ha hb hU, rfl⟩
  · have hne' : {k | ∃ U : Cert, CertifiesCoprimeness U a b ∧ U.rems.card = k}.Nonempty := by
      obtain ⟨U, hU, -⟩ := Nat.sInf_mem hne
      exact ⟨_, _, certifiesCoprimeness_of_certifiesCoprime ha hb hU, rfl⟩
    obtain ⟨U, ⟨hS, hG, hπ⟩, hk⟩ := Nat.sInf_mem hne'
    unfold callsCoprimeness callsRem
    rw [← hk]
    exact Nat.sInf_le ⟨U, ⟨hS, hG, fun π h ↦ ((hπ π h).2 ⟨ha, hb, hc⟩).2.2⟩, rfl⟩

/-- For `a, b > 0`, `callsCoprimeness a b ≤ G a b + 2`. -/
theorem callsCoprimeness_le {a b : ℕ} (ha : 0 < a) (hb : 0 < b) :
    callsCoprimeness a b ≤ G a b + 2 := by
  unfold callsCoprimeness
  by_cases hc : Nat.Coprime a b
  · obtain ⟨U, hU, hcard⟩ := coprime_certificate_bound hc
    have hmem : U.rems.card ∈ {k | ∃ U : Cert, CertifiesCoprimeness U a b ∧ U.rems.card = k} :=
      ⟨_, certifiesCoprimeness_of_certifiesCoprime ha hb hU, rfl⟩
    exact (Nat.sInf_le hmem).trans (by omega)
  · obtain ⟨U, hS, hG, hcard, hπ⟩ := noncoprime_certificate_bound ha hc
    have hmem : U.rems.card ∈ {k | ∃ U : Cert, CertifiesCoprimeness U a b ∧ U.rems.card = k} :=
      ⟨U, ⟨hS, hG, fun π h ↦ iff_of_false (fun h' ↦ hπ π h h'.2.2) fun h' ↦ hc h'.2.2⟩, rfl⟩
    exact (Nat.sInf_le hmem).trans hcard

/-- For `a > 0` and every `b`, `callsGcd a b ≤ G a b + 2`. -/
theorem callsGcd_le {a b : ℕ} (ha : 0 < a) : callsGcd a b ≤ G a b + 2 := by
  unfold callsGcd
  obtain ⟨U, hU, h1, hcard⟩ := gcd_certificate_bound (b := b) ha
  have hmem : U.rems.card ∈ {k | ∃ U : Cert, U.CertifiesGcd a b ∧ U.eq1s = ∅ ∧
      U.rems.card = k} := ⟨U, hU, h1, rfl⟩
  exact (Nat.sInf_le hmem).trans hcard

/-- The certificate consisting of the single fact `eq0(0) = tt`. -/
def zeroCert : Cert := ⟨∅, {(0, true)}, ∅⟩

theorem zeroCert_certifiesGcd_right (x : ℕ) : zeroCert.CertifiesGcd x 0 := by
  refine ⟨⟨by simp [zeroCert, SoundRems], by simp [zeroCert], by simp [zeroCert]⟩,
    ⟨by simp [zeroCert], by simpa [zeroCert] using Reach.right, by simp [zeroCert]⟩,
    by simpa [zeroCert] using Reach.left, fun π hπ ↦ ?_⟩
  have h0 : π 0 = 0 := by simpa [zeroCert] using hπ.2.1 (0, true) (by simp [zeroCert])
  simp [h0]

theorem zeroCert_certifiesGcd_left (y : ℕ) : zeroCert.CertifiesGcd 0 y := by
  refine ⟨⟨by simp [zeroCert, SoundRems], by simp [zeroCert], by simp [zeroCert]⟩,
    ⟨by simp [zeroCert], by simpa [zeroCert] using Reach.left, by simp [zeroCert]⟩,
    by simpa [zeroCert] using Reach.right, fun π hπ ↦ ?_⟩
  have h0 : π 0 = 0 := by simpa [zeroCert] using hπ.2.1 (0, true) (by simp [zeroCert])
  simp [h0]

/-- `callsGcd x 0 = 0`: a zero second input needs no remainder facts. -/
theorem callsGcd_zero_right (x : ℕ) : callsGcd x 0 = 0 :=
  Nat.eq_zero_of_le_zero (Nat.sInf_le ⟨zeroCert, zeroCert_certifiesGcd_right x, rfl, rfl⟩)

/-- `callsGcd 0 y = 0`: a zero first input needs no remainder facts. -/
theorem callsGcd_zero_left (y : ℕ) : callsGcd 0 y = 0 :=
  Nat.eq_zero_of_le_zero (Nat.sInf_le ⟨zeroCert, zeroCert_certifiesGcd_left y, rfl, rfl⟩)

/-- Every pair has a gcd certificate without `eq1` facts. -/
theorem callsGcd_set_nonempty (a b : ℕ) :
    {k | ∃ U : Cert, U.CertifiesGcd a b ∧ U.eq1s = ∅ ∧ U.rems.card = k}.Nonempty := by
  rcases Nat.eq_zero_or_pos a with rfl | ha
  · exact ⟨_, zeroCert, zeroCert_certifiesGcd_left b, rfl, rfl⟩
  · obtain ⟨U, hU, h1, -⟩ := gcd_certificate_bound (b := b) ha
    exact ⟨_, U, hU, h1, rfl⟩

/-- Allowing `eq1` facts (the structure `Nε`) can only lower the gcd complexity. -/
theorem callsRemGcd_le_callsGcd (a b : ℕ) : callsRemGcd a b ≤ callsGcd a b := by
  obtain ⟨V, hV, -, hk⟩ := Nat.sInf_mem (callsGcd_set_nonempty a b)
  unfold callsRemGcd callsGcd
  rw [← hk]
  exact Nat.sInf_le ⟨V, hV, rfl⟩

/-- **Both intrinsic complexities are `o(log)`, uniformly.** For every `ε > 0`, eventually in
`M`, every pair with `0 < a ≤ M` and `0 < b ≤ M` has both complexities at most `ε log₂ M`. -/
theorem eventually_calls_le {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ M : ℕ in atTop, ∀ a b, 0 < a → 0 < b → a ≤ M → b ≤ M →
      (callsCoprimeness a b : ℝ) ≤ ε * Real.logb 2 M ∧
        (callsGcd a b : ℝ) ≤ ε * Real.logb 2 M := by
  have h1 := sizeCost_isLittleO_log.def (show 0 < ε / 2 by positivity)
  have hlog : Tendsto (fun M : ℕ ↦ Real.logb 2 (M : ℝ)) atTop atTop :=
    (Real.tendsto_logb_atTop (by norm_num)).comp tendsto_natCast_atTop_atTop
  filter_upwards [h1, hlog.eventually_ge_atTop (4 / ε), eventually_ge_atTop 1]
    with M hM hlarge hM1 a b ha hb haM hbM
  have hlog0 : 0 ≤ Real.logb 2 (M : ℝ) :=
    Real.logb_nonneg (by norm_num) (by exact_mod_cast hM1)
  rw [Real.norm_of_nonneg (Nat.cast_nonneg _), Real.norm_of_nonneg hlog0] at hM
  have hG : (G a b : ℝ) ≤ sizeCost M := by exact_mod_cast G_le_sizeCost haM hbM
  have htwo : (2 : ℝ) ≤ ε / 2 * Real.logb 2 M := by
    have := mul_le_mul_of_nonneg_left hlarge (show 0 ≤ ε / 2 by positivity)
    have he : ε / 2 * (4 / ε) = 2 := by field_simp; ring
    linarith
  have hc : (callsCoprimeness a b : ℝ) ≤ G a b + 2 := by
    exact_mod_cast callsCoprimeness_le ha hb
  have hg : (callsGcd a b : ℝ) ≤ G a b + 2 := by exact_mod_cast callsGcd_le ha
  constructor <;> linarith

/-- **Conjecture 3.4 of the 2012 notes is false.** There is no `r > 0` with
`calls(rem)(Nε, ⊥⊥, a, b) ≥ r log₂ a` for infinitely many `a ≥ b ≥ 1`. -/
theorem not_conjecture_3_4 :
    ¬ ∃ r : ℝ, 0 < r ∧ {p : ℕ × ℕ | 1 ≤ p.2 ∧ p.2 ≤ p.1 ∧
      r * Real.logb 2 p.1 ≤ callsCoprimeness p.1 p.2}.Infinite := by
  rintro ⟨r, hr, hinf⟩
  obtain ⟨N, hN⟩ := eventually_atTop.1
    ((eventually_calls_le (half_pos hr)).and (eventually_ge_atTop 2))
  apply hinf
  refine (Finset.range N ×ˢ Finset.range N).finite_toSet.subset ?_
  rintro ⟨a, b⟩ ⟨hb1, hba, hcalls⟩
  simp only [Finset.coe_product, Set.mem_prod, Finset.coe_range, Set.mem_Iio]
  by_contra hlt
  have haN : N ≤ a := by omega
  obtain ⟨hle, ha2⟩ := hN a haN
  have hpos : 0 < Real.logb 2 (a : ℝ) :=
    Real.logb_pos (by norm_num) (by exact_mod_cast (show 1 < a by omega))
  have := (hle a b (by omega) (by omega) le_rfl hba).1
  have hhalf : r / 2 * Real.logb 2 (a : ℝ) < r * Real.logb 2 (a : ℝ) :=
    mul_lt_mul_of_pos_right (half_lt_self hr) hpos
  dsimp only at hcalls
  linarith

/-- **The precise version (4F-5) of the Main Conjecture is false.** There is no `K > 0` with
`2 log₂ max(x, y) ≤ K · calls(rem)(gcd, x, y)` for infinitely many pairs `(x, y) ∈ ℕ²`. -/
theorem not_main_conjecture_4F5 :
    ¬ ∃ K : ℝ, 0 < K ∧ {p : ℕ × ℕ |
      2 * Real.logb 2 (max p.1 p.2 : ℕ) ≤ K * callsGcd p.1 p.2}.Infinite := by
  rintro ⟨K, hK, hinf⟩
  obtain ⟨N, hN⟩ := eventually_atTop.1
    ((eventually_calls_le (inv_pos.2 hK)).and (eventually_ge_atTop 2))
  apply hinf
  refine (Finset.range N ×ˢ Finset.range N).finite_toSet.subset ?_
  rintro ⟨x, y⟩ hcalls
  simp only [Set.mem_ofPred_eq] at hcalls
  simp only [Finset.coe_product, Set.mem_prod, Finset.coe_range, Set.mem_Iio]
  by_contra hlt
  have hMN : N ≤ max x y := by omega
  obtain ⟨hle, hM2⟩ := hN (max x y) hMN
  have hpos : 0 < Real.logb 2 ((max x y : ℕ) : ℝ) :=
    Real.logb_pos (by norm_num) (by exact_mod_cast (show 1 < max x y by omega))
  rcases Nat.eq_zero_or_pos x with rfl | hx
  · rw [callsGcd_zero_left] at hcalls
    simp only [Nat.cast_zero, mul_zero] at hcalls
    linarith
  rcases Nat.eq_zero_or_pos y with rfl | hy
  · rw [callsGcd_zero_right] at hcalls
    simp only [Nat.cast_zero, mul_zero] at hcalls
    linarith
  have h := (hle x y hx hy (le_max_left _ _) (le_max_right _ _)).2
  have hK' : K * callsGcd x y ≤ Real.logb 2 ((max x y : ℕ) : ℝ) := by
    have := mul_le_mul_of_nonneg_left h hK.le
    rwa [← mul_assoc, mul_inv_cancel₀ hK.ne', one_mul] at this
  linarith

/-- (4F-5) also fails when the structure includes `eq1`: the gcd complexity in `Nε`
(`callsRemGcd`) is no larger than in `(ℕ, rem, eq0)`. -/
theorem not_main_conjecture_4F5_Neps :
    ¬ ∃ K : ℝ, 0 < K ∧ {p : ℕ × ℕ |
      2 * Real.logb 2 (max p.1 p.2 : ℕ) ≤ K * callsRemGcd p.1 p.2}.Infinite := by
  rintro ⟨K, hK, hinf⟩
  refine not_main_conjecture_4F5 ⟨K, hK, hinf.mono fun p hp ↦ ?_⟩
  simp only [Set.mem_ofPred_eq] at hp ⊢
  exact hp.trans (mul_le_mul_of_nonneg_left
    (by exact_mod_cast callsRemGcd_le_callsGcd p.1 p.2) hK.le)

/-- **Conjecture 3.4, read literally**: a rational `r > 0` and infinitely many `a`, each with
some `1 ≤ b ≤ a`. This follows from `not_conjecture_3_4`, which allows real `r` and counts
pairs. -/
theorem not_conjecture_3_4_literal :
    ¬ ∃ r : ℚ, 0 < r ∧ {a : ℕ | ∃ b, 1 ≤ b ∧ b ≤ a ∧
      (r : ℝ) * Real.logb 2 a ≤ callsCoprimeness a b}.Infinite := by
  rintro ⟨r, hr, hinf⟩
  apply not_conjecture_3_4
  refine ⟨r, by exact_mod_cast hr, fun hfin ↦ hinf ?_⟩
  refine (hfin.image Prod.fst).subset ?_
  rintro a ⟨b, h1, h2, h3⟩
  exact ⟨(a, b), ⟨h1, h2, h3⟩, rfl⟩

/-- **(4F-5), read literally**, in `Nε`: there are no set `D ⊆ ℕ²` and `K > 0` such that
`2 log₂ max(x, y) ≤ K · calls(rem)(Nε, gcd, x, y)` on `D` while the complexity is unbounded on
`D` (condition (4F-4)). The book's first inequality, `calls(rem)(ε, x, y) ≤ L(x, y)`, is
dropped, which only weakens the statement refuted and so strengthens the refutation. -/
theorem not_main_conjecture_4F5_literal :
    ¬ ∃ (D : Set (ℕ × ℕ)) (K : ℝ), 0 < K ∧
      (∀ p ∈ D, 2 * Real.logb 2 (max p.1 p.2 : ℕ) ≤ K * callsRemGcd p.1 p.2) ∧
      ¬ BddAbove ((fun p : ℕ × ℕ ↦ callsRemGcd p.1 p.2) '' D) := by
  rintro ⟨D, K, hK, hD, hunb⟩
  apply not_main_conjecture_4F5_Neps
  refine ⟨K, hK, Set.Infinite.mono (fun p hp ↦ hD p hp) fun hfin ↦ ?_⟩
  exact hunb (hfin.image _).bddAbove

end ShortGCD
