module

public import ShortGCD.Conjecture

@[expose] public section

/-! # The book's certificates

Moschovakis's definitions, for the Euclidean structure `Nε = (ℕ, rem, eq0, eq1)` and its reduct
`N₀ = (ℕ, rem, eq0)` (*Abstract Recursion and Intrinsic Complexity*, 2019, §§1D, 4C–4E):

* a partial substructure `U ⊆ₚ Nε` has a universe `U ⊆ ℕ` and partial operations on it that agree
  with those of `Nε` where defined; `rem` is defined only at nonzero divisors (§1D);
* `U` is generated by `a, b` if every element of `U` is reached from `a, b` by the operations of
  `U` (1D-14);
* a homomorphism `π : U → Nε` is a map on the universe that preserves every defined operation and
  test (1D-11);
* `U` certifies `f` at `a, b` if it is finite, generated by `a, b`, contains `a, b` (and the value,
  for gcd), and every homomorphism respects `f` there (§4D);
* the norm `calls(rem)(U)` is the number of entries in the graph of `rem` in `U` (§4C), and the
  intrinsic complexity is its least value over certificates (4E-1).

Here `Struct` is a finite partial structure given by its universe and its partial operations;
`IsSub` says it is a partial substructure of `Nε`, and one of `N₀` when `eq1` is nowhere defined.
The main theorems show that the resulting intrinsic complexities are exactly the fact-based
complexities `ShortGCD.callsCoprimeness`, `ShortGCD.callsRemGcd` and `ShortGCD.callsGcd` used in
the refutations. This is the fact-representation lemma of the paper.
-/

namespace ShortGCD.Book

/-- A finite partial structure in the vocabulary `{rem, eq0, eq1}`: a finite universe and partial
operations, given as functions with values in `Option`. -/
structure Struct where
  univ : Finset ℕ
  rem : ℕ → ℕ → Option ℕ
  eq0 : ℕ → Option Bool
  eq1 : ℕ → Option Bool

namespace Struct

/-- `U ⊆ₚ Nε`: the operations act on the universe and agree with those of `Nε` where defined. -/
def IsSub (U : Struct) : Prop :=
  (∀ x y w, U.rem x y = some w → x ∈ U.univ ∧ y ∈ U.univ ∧ w ∈ U.univ ∧ y ≠ 0 ∧ w = x % y) ∧
  (∀ x t, U.eq0 x = some t → x ∈ U.univ ∧ (x = 0 ↔ t = true)) ∧
  (∀ x t, U.eq1 x = some t → x ∈ U.univ ∧ (x = 1 ↔ t = true))

/-- The elements reached from `a, b` by the operations of `U`. -/
inductive Gen (U : Struct) (a b : ℕ) : ℕ → Prop
  | left : Gen U a b a
  | right : Gen U a b b
  | rem {x y w : ℕ} : U.rem x y = some w → Gen U a b x → Gen U a b y → Gen U a b w

/-- `U` is generated by `a, b` (and contains them). -/
def Generated (U : Struct) (a b : ℕ) : Prop :=
  a ∈ U.univ ∧ b ∈ U.univ ∧ ∀ x ∈ U.univ, U.Gen a b x

/-- A homomorphism `π : U → Nε`, defined on the universe of `U`. -/
def IsHom (U : Struct) (π : U.univ → ℕ) : Prop :=
  (∀ x y w : U.univ, U.rem x y = some w → π y ≠ 0 ∧ π w = π x % π y) ∧
  (∀ (x : U.univ) (t : Bool), U.eq0 x = some t → (π x = 0 ↔ t = true)) ∧
  (∀ (x : U.univ) (t : Bool), U.eq1 x = some t → (π x = 1 ↔ t = true))

/-- `calls(rem)(U)`: the number of entries in the graph of `rem` in `U`. -/
def calls (U : Struct) : ℕ :=
  ((U.univ ×ˢ U.univ).filter (fun p => (U.rem p.1 p.2).isSome)).card

/-- `U` certifies `gcd(a, b)` in `Nε`. -/
def CertifiesGcd (U : Struct) (a b : ℕ) : Prop :=
  U.IsSub ∧ U.Generated a b ∧ Nat.gcd a b ∈ U.univ ∧
    ∀ π, U.IsHom π → ∀ (ha : a ∈ U.univ) (hb : b ∈ U.univ) (hg : Nat.gcd a b ∈ U.univ),
      π ⟨_, hg⟩ = Nat.gcd (π ⟨a, ha⟩) (π ⟨b, hb⟩)

/-- `U` certifies the truth value of `a ⊥⊥ b` in `Nε`. -/
def CertifiesCoprimeness (U : Struct) (a b : ℕ) : Prop :=
  U.IsSub ∧ U.Generated a b ∧
    ∀ π, U.IsHom π → ∀ (ha : a ∈ U.univ) (hb : b ∈ U.univ),
      (BookCoprime (π ⟨a, ha⟩) (π ⟨b, hb⟩) ↔ BookCoprime a b)

end Struct

/-- The book's `calls(rem)(Nε, ⊥⊥, a, b)`. -/
noncomputable def callsCoprimeness (a b : ℕ) : ℕ :=
  sInf {k | ∃ U : Struct, U.CertifiesCoprimeness a b ∧ U.calls = k}

/-- The book's `calls(rem)(Nε, gcd, a, b)`. -/
noncomputable def callsRemGcd (a b : ℕ) : ℕ :=
  sInf {k | ∃ U : Struct, U.CertifiesGcd a b ∧ U.calls = k}

/-- The book's `calls(rem)(N₀, gcd, a, b)`: certificates in `N₀` have no `eq1` entries. -/
noncomputable def callsGcd (a b : ℕ) : ℕ :=
  sInf {k | ∃ U : Struct, U.CertifiesGcd a b ∧ (∀ x, U.eq1 x = none) ∧ U.calls = k}

/-! ## From the book's structures to fact sets -/

/-- The fact set of a structure: its remainder graph and its test entries. -/
def toCert (U : Struct) : Cert where
  rems := ((U.univ ×ˢ U.univ).filter (fun p => (U.rem p.1 p.2).isSome)).image
    (fun p => (p.1, p.2, p.1 % p.2))
  eq0s := (U.univ.filter (fun x => (U.eq0 x).isSome)).image (fun x => (x, decide (x = 0)))
  eq1s := (U.univ.filter (fun x => (U.eq1 x).isSome)).image (fun x => (x, decide (x = 1)))

lemma toCert_card (U : Struct) : (toCert U).rems.card = U.calls := by
  unfold toCert Struct.calls
  apply Finset.card_image_of_injective
  intro p q h
  simp only [Prod.mk.injEq] at h
  exact Prod.ext h.1 h.2.1

lemma mem_toCert_rems {U : Struct} (hU : U.IsSub) {x y w : ℕ} (h : U.rem x y = some w) :
    (x, y, w) ∈ (toCert U).rems := by
  obtain ⟨hx, hy, -, -, rfl⟩ := hU.1 x y w h
  exact Finset.mem_image.mpr ⟨(x, y), Finset.mem_filter.mpr
    ⟨Finset.mem_product.mpr ⟨hx, hy⟩, by simp [h]⟩, rfl⟩

lemma Struct.Gen.reach {U : Struct} (hU : U.IsSub) {a b x : ℕ} (h : U.Gen a b x) :
    Reach (toCert U).rems a b x := by
  induction h with
  | left => exact .left
  | right => exact .right
  | rem hr _ _ ihx ihy => exact .step (mem_toCert_rems hU hr) ihx ihy

lemma toCert_sound {U : Struct} (hU : U.IsSub) : (toCert U).Sound := by
  refine ⟨?_, ?_, ?_⟩
  · intro f hf
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hf
    obtain ⟨-, hs⟩ := Finset.mem_filter.mp hp
    obtain ⟨w, hw⟩ := Option.isSome_iff_exists.mp hs
    exact ⟨(hU.1 _ _ _ hw).2.2.2.1, rfl⟩
  · intro q hq
    obtain ⟨x, -, rfl⟩ := Finset.mem_image.mp hq
    simp
  · intro q hq
    obtain ⟨x, -, rfl⟩ := Finset.mem_image.mp hq
    simp

lemma toCert_generated {U : Struct} (hU : U.IsSub) {a b : ℕ} (hg : U.Generated a b) :
    (toCert U).Generated a b := by
  refine ⟨?_, ?_, ?_⟩
  · intro f hf
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hf
    obtain ⟨hmem, -⟩ := Finset.mem_filter.mp hp
    obtain ⟨h1, h2⟩ := Finset.mem_product.mp hmem
    exact ⟨(hg.2.2 _ h1).reach hU, (hg.2.2 _ h2).reach hU⟩
  · intro q hq
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hq
    exact (hg.2.2 _ (Finset.mem_filter.mp hx).1).reach hU
  · intro q hq
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hq
    exact (hg.2.2 _ (Finset.mem_filter.mp hx).1).reach hU

/-- A total map preserving the facts restricts to a homomorphism on the universe. -/
lemma isHom_of_respects {U : Struct} (hU : U.IsSub) {π : ℕ → ℕ}
    (hπ : (toCert U).Respects π) : U.IsHom (fun x => π x) := by
  refine ⟨?_, ?_, ?_⟩
  · intro x y w h
    have hm := mem_toCert_rems hU h
    exact hπ.1 _ hm
  · intro x t h
    obtain ⟨hx, hxt⟩ := hU.2.1 x t h
    have hm : ((x : ℕ), decide ((x : ℕ) = 0)) ∈ (toCert U).eq0s :=
      Finset.mem_image.mpr ⟨x, Finset.mem_filter.mpr ⟨hx, by simp [h]⟩, rfl⟩
    have := hπ.2.1 _ hm
    simp only [decide_eq_true_eq] at this
    rw [this, hxt]
  · intro x t h
    obtain ⟨hx, hxt⟩ := hU.2.2 x t h
    have hm : ((x : ℕ), decide ((x : ℕ) = 1)) ∈ (toCert U).eq1s :=
      Finset.mem_image.mpr ⟨x, Finset.mem_filter.mpr ⟨hx, by simp [h]⟩, rfl⟩
    have := hπ.2.2 _ hm
    simp only [decide_eq_true_eq] at this
    rw [this, hxt]

theorem toCert_certifiesGcd {U : Struct} {a b : ℕ} (h : U.CertifiesGcd a b) :
    (toCert U).CertifiesGcd a b := by
  obtain ⟨hU, hg, hgcd, hcert⟩ := h
  refine ⟨toCert_sound hU, toCert_generated hU hg, (hg.2.2 _ hgcd).reach hU, ?_⟩
  intro π hπ
  exact hcert _ (isHom_of_respects hU hπ) hg.1 hg.2.1 hgcd

theorem toCert_certifiesCoprimeness {U : Struct} {a b : ℕ} (h : U.CertifiesCoprimeness a b) :
    CertifiesCoprimeness (toCert U) a b := by
  obtain ⟨hU, hg, hcert⟩ := h
  refine ⟨toCert_sound hU, toCert_generated hU hg, ?_⟩
  intro π hπ
  exact hcert _ (isHom_of_respects hU hπ) hg.1 hg.2.1

lemma toCert_eq1s {U : Struct} (h : ∀ x, U.eq1 x = none) : (toCert U).eq1s = ∅ := by
  simp [toCert, h]

/-! ## From fact sets to the book's structures -/

/-- The structure of a fact set: its universe consists of `a, b` and every number occurring in a
fact, and each operation is defined exactly at the recorded arguments. -/
def ofCert (U : Cert) (a b : ℕ) : Struct where
  univ := {a, b} ∪ U.rems.biUnion (fun f => {f.1, f.2.1, f.2.2}) ∪ U.eq0s.image Prod.fst ∪
    U.eq1s.image Prod.fst
  rem x y := if (x, y, x % y) ∈ U.rems then some (x % y) else none
  eq0 x := if (x, true) ∈ U.eq0s then some true else if (x, false) ∈ U.eq0s then some false
    else none
  eq1 x := if (x, true) ∈ U.eq1s then some true else if (x, false) ∈ U.eq1s then some false
    else none

lemma ofCert_rem {U : Cert} (hs : U.Sound) {a b x y w : ℕ} :
    (ofCert U a b).rem x y = some w ↔ (x, y, w) ∈ U.rems := by
  simp only [ofCert]
  split_ifs with h
  · constructor
    · intro hw; cases hw; exact h
    · intro hm
      have := (hs.1 _ hm).2
      simp only at this
      rw [this]
  · constructor
    · intro hw; cases hw
    · intro hm
      have := (hs.1 _ hm).2
      simp only at this
      exact absurd (this ▸ hm) h

lemma ofCert_test {s : Finset (ℕ × Bool)} {c : ℕ} (hs : ∀ p ∈ s, (p.1 = c ↔ p.2 = true))
    {x : ℕ} {t : Bool} :
    (if (x, true) ∈ s then some true else if (x, false) ∈ s then some false else none) = some t ↔
      (x, t) ∈ s := by
  by_cases h1 : (x, true) ∈ s
  · have hx : x = c := by simpa using hs _ h1
    have h2 : (x, false) ∉ s := fun h => by simpa [hx] using hs _ h
    cases t <;> simp [h1, h2]
  · cases t <;> simp [h1]

lemma ofCert_eq0 {U : Cert} (hs : U.Sound) {a b x : ℕ} {t : Bool} :
    (ofCert U a b).eq0 x = some t ↔ (x, t) ∈ U.eq0s :=
  ofCert_test hs.2.1

lemma ofCert_eq1 {U : Cert} (hs : U.Sound) {a b x : ℕ} {t : Bool} :
    (ofCert U a b).eq1 x = some t ↔ (x, t) ∈ U.eq1s :=
  ofCert_test hs.2.2

lemma mem_ofCert_of_rem {U : Cert} {a b : ℕ} {f : RemFact} (hf : f ∈ U.rems) :
    f.1 ∈ (ofCert U a b).univ ∧ f.2.1 ∈ (ofCert U a b).univ ∧ f.2.2 ∈ (ofCert U a b).univ := by
  have h : ∀ z ∈ ({f.1, f.2.1, f.2.2} : Finset ℕ), z ∈ (ofCert U a b).univ := by
    intro z hz
    simp only [ofCert, Finset.mem_union]
    exact Or.inl (Or.inl (Or.inr (Finset.mem_biUnion.mpr ⟨f, hf, hz⟩)))
  exact ⟨h _ (by simp), h _ (by simp), h _ (by simp)⟩

lemma reach_mem {U : Cert} {a b x : ℕ} (h : Reach U.rems a b x) : x ∈ (ofCert U a b).univ := by
  cases h with
  | left => simp [ofCert]
  | right => simp [ofCert]
  | step hf _ _ => exact (mem_ofCert_of_rem hf).2.2

lemma reach_gen {U : Cert} (hs : U.Sound) {a b x : ℕ} (h : Reach U.rems a b x) :
    (ofCert U a b).Gen a b x := by
  induction h with
  | left => exact .left
  | right => exact .right
  | step hf _ _ ihx ihy => exact .rem ((ofCert_rem hs).mpr hf) ihx ihy

lemma ofCert_isSub {U : Cert} (hs : U.Sound) (a b : ℕ) : (ofCert U a b).IsSub := by
  refine ⟨?_, ?_, ?_⟩
  · intro x y w h
    have hm := (ofCert_rem hs).mp h
    obtain ⟨hx, hy, hw⟩ := mem_ofCert_of_rem (a := a) (b := b) hm
    exact ⟨hx, hy, hw, (hs.1 _ hm).1, (hs.1 _ hm).2⟩
  · intro x t h
    have hm := (ofCert_eq0 hs).mp h
    refine ⟨?_, hs.2.1 _ hm⟩
    simp only [ofCert, Finset.mem_union]
    exact Or.inl (Or.inr (Finset.mem_image.mpr ⟨_, hm, rfl⟩))
  · intro x t h
    have hm := (ofCert_eq1 hs).mp h
    refine ⟨?_, hs.2.2 _ hm⟩
    simp only [ofCert, Finset.mem_union]
    exact Or.inr (Finset.mem_image.mpr ⟨_, hm, rfl⟩)

lemma ofCert_generated {U : Cert} (hs : U.Sound) {a b : ℕ} (hg : U.Generated a b) :
    (ofCert U a b).Generated a b := by
  refine ⟨by simp [ofCert], by simp [ofCert], ?_⟩
  intro x hx
  simp only [ofCert, Finset.mem_union, Finset.mem_insert, Finset.mem_singleton,
    Finset.mem_biUnion, Finset.mem_image] at hx
  rcases hx with ((((rfl | rfl) | ⟨f, hf, hxf⟩) | ⟨p, hp, rfl⟩) | ⟨p, hp, rfl⟩)
  · exact .left
  · exact .right
  · rcases hxf with rfl | rfl | rfl
    · exact reach_gen hs (hg.1 f hf).1
    · exact reach_gen hs (hg.1 f hf).2
    · exact reach_gen hs (.step hf (hg.1 f hf).1 (hg.1 f hf).2)
  · exact reach_gen hs (hg.2.1 p hp)
  · exact reach_gen hs (hg.2.2 p hp)

/-- Every homomorphism on the universe extends to a total map preserving the facts. -/
lemma respects_of_isHom {U : Cert} (hs : U.Sound) {a b : ℕ} {π : (ofCert U a b).univ → ℕ}
    (hπ : (ofCert U a b).IsHom π) :
    U.Respects (fun x => if h : x ∈ (ofCert U a b).univ then π ⟨x, h⟩ else 0) := by
  refine ⟨?_, ?_, ?_⟩
  · intro f hf
    obtain ⟨hx, hy, hw⟩ := mem_ofCert_of_rem (a := a) (b := b) hf
    have h := hπ.1 ⟨_, hx⟩ ⟨_, hy⟩ ⟨_, hw⟩ ((ofCert_rem hs).mpr hf)
    simpa [hx, hy, hw] using h
  · intro p hp
    have hx : p.1 ∈ (ofCert U a b).univ := by
      simp only [ofCert, Finset.mem_union]
      exact Or.inl (Or.inr (Finset.mem_image.mpr ⟨_, hp, rfl⟩))
    have h := hπ.2.1 ⟨_, hx⟩ p.2 ((ofCert_eq0 hs).mpr hp)
    simpa [hx] using h
  · intro p hp
    have hx : p.1 ∈ (ofCert U a b).univ := by
      simp only [ofCert, Finset.mem_union]
      exact Or.inr (Finset.mem_image.mpr ⟨_, hp, rfl⟩)
    have h := hπ.2.2 ⟨_, hx⟩ p.2 ((ofCert_eq1 hs).mpr hp)
    simpa [hx] using h

theorem ofCert_certifiesGcd {U : Cert} {a b : ℕ} (h : U.CertifiesGcd a b) :
    (ofCert U a b).CertifiesGcd a b := by
  obtain ⟨hs, hg, hgcd, hcert⟩ := h
  refine ⟨ofCert_isSub hs a b, ofCert_generated hs hg, reach_mem hgcd, ?_⟩
  intro π hπ ha hb hg'
  have := hcert _ (respects_of_isHom hs hπ)
  simpa [ha, hb, hg'] using this

theorem ofCert_certifiesCoprimeness {U : Cert} {a b : ℕ} (h : CertifiesCoprimeness U a b) :
    (ofCert U a b).CertifiesCoprimeness a b := by
  obtain ⟨hs, hg, hcert⟩ := h
  refine ⟨ofCert_isSub hs a b, ofCert_generated hs hg, ?_⟩
  intro π hπ ha hb
  have := hcert _ (respects_of_isHom hs hπ)
  simpa [ha, hb] using this

lemma ofCert_calls {U : Cert} (hs : U.Sound) (a b : ℕ) : (ofCert U a b).calls = U.rems.card := by
  have himage : U.rems = (((ofCert U a b).univ ×ˢ (ofCert U a b).univ).filter
      (fun p => ((ofCert U a b).rem p.1 p.2).isSome)).image (fun p => (p.1, p.2, p.1 % p.2)) := by
    ext f
    constructor
    · intro hf
      obtain ⟨hx, hy, -⟩ := mem_ofCert_of_rem (a := a) (b := b) hf
      have hv : f.2.2 = f.1 % f.2.1 := (hs.1 _ hf).2
      refine Finset.mem_image.mpr ⟨(f.1, f.2.1), Finset.mem_filter.mpr
        ⟨Finset.mem_product.mpr ⟨hx, hy⟩, ?_⟩, ?_⟩
      · have : (ofCert U a b).rem f.1 f.2.1 = some f.2.2 := (ofCert_rem hs).mpr hf
        simp [this]
      · rw [← hv]
    · intro hf
      obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hf
      obtain ⟨-, hsome⟩ := Finset.mem_filter.mp hp
      obtain ⟨w, hw⟩ := Option.isSome_iff_exists.mp hsome
      have hm := (ofCert_rem hs).mp hw
      have hv : w = p.1 % p.2 := (hs.1 _ hm).2
      rwa [hv] at hm
  unfold Struct.calls
  rw [himage, Finset.card_image_of_injective]
  intro p q h
  simp only [Prod.mk.injEq] at h
  exact Prod.ext h.1 h.2.1

lemma ofCert_eq1_none {U : Cert} {a b : ℕ} (h : U.eq1s = ∅) (x : ℕ) :
    (ofCert U a b).eq1 x = none := by
  simp [ofCert, h]

/-! ## The book's intrinsic complexities are the fact-based ones -/

/-- `calls(rem)(Nε, ⊥⊥, a, b)` in the book's sense equals `ShortGCD.callsCoprimeness a b`. -/
theorem callsCoprimeness_eq (a b : ℕ) :
    callsCoprimeness a b = ShortGCD.callsCoprimeness a b := by
  unfold callsCoprimeness ShortGCD.callsCoprimeness
  congr 1
  ext k
  constructor
  · rintro ⟨U, hU, rfl⟩
    exact ⟨toCert U, toCert_certifiesCoprimeness hU, toCert_card U⟩
  · rintro ⟨U, hU, rfl⟩
    exact ⟨ofCert U a b, ofCert_certifiesCoprimeness hU, ofCert_calls hU.1 a b⟩

/-- `calls(rem)(Nε, gcd, a, b)` in the book's sense equals `ShortGCD.callsRemGcd a b`. -/
theorem callsRemGcd_eq (a b : ℕ) : callsRemGcd a b = ShortGCD.callsRemGcd a b := by
  unfold callsRemGcd ShortGCD.callsRemGcd
  congr 1
  ext k
  constructor
  · rintro ⟨U, hU, rfl⟩
    exact ⟨toCert U, toCert_certifiesGcd hU, toCert_card U⟩
  · rintro ⟨U, hU, rfl⟩
    exact ⟨ofCert U a b, ofCert_certifiesGcd hU, ofCert_calls hU.1 a b⟩

/-- `calls(rem)(N₀, gcd, a, b)` in the book's sense equals `ShortGCD.callsGcd a b`. -/
theorem callsGcd_eq (a b : ℕ) : callsGcd a b = ShortGCD.callsGcd a b := by
  unfold callsGcd ShortGCD.callsGcd
  congr 1
  ext k
  constructor
  · rintro ⟨U, hU, h1, rfl⟩
    exact ⟨toCert U, toCert_certifiesGcd hU, toCert_eq1s h1, toCert_card U⟩
  · rintro ⟨U, hU, h1, rfl⟩
    exact ⟨ofCert U a b, ofCert_certifiesGcd hU, ofCert_eq1_none h1, ofCert_calls hU.1 a b⟩

end ShortGCD.Book
